# Definedge Integrate API
API_TOKEN=
API_SECRET=

# --- Option A (recommended when available): External TOTP — fully automatic ---
# Definedge → Account → Security → Enable External TOTP → copy the base32 secret
# TOTP_SECRET=

# --- Option B (works now): SMS OTP once per ~24 hours ---
# Run: ./scripts/morning_login.sh
# Or:  ./venv/bin/python scripts/setup_definedge_auth.py --otp 123456
# Saves INTEGRATE_* session keys below — cron/live use these until expiry.
# INTEGRATE_UID=
# INTEGRATE_ACTID=
# INTEGRATE_API_SESSION_KEY=
# INTEGRATE_WS_SESSION_KEY=

# --- Telegram remote OTP + notifications (local bot OR cloud Docker) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub data sync (optional — cloud bot pushes snapshots to data branch) ---
GITHUB_TOKEN=
GITHUB_REPO=lastbencher/banknifty-engine
GITHUB_DATA_BRANCH=data
